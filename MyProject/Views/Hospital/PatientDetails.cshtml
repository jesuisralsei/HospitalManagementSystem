@model MyProject.Models.Patient
@{
    ViewData["Title"] = $"{Model.PatientName} Details";
}

<div class="container py-4">
    <!-- Patient Profile Header -->
    <div class="card shadow border-0 rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center mb-4">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle me-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-person-vcard" viewBox="0 0 16 16">
                        <path d="M5 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm4-2.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5ZM9 8a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4A.5.5 0 0 1 9 8Zm1 2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5Z" />
                        <path d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H2ZM1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4Z" />
                    </svg>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-dark">@Model.PatientName</h1>
                    <span class="badge bg-primary-subtle text-primary fw-medium px-3 py-2 rounded-pill">
                        Patient ID: @Model.PatientId
                    </span>
                </div>
            </div>

            <hr class="text-muted my-4" />

            <!-- Details Grid -->
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Age</small>
                        <span class="fs-5 fw-semibold text-dark">@Model.PatientAge Years</span>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Location</small>
                        <span class="fs-5 fw-semibold text-dark">@Model.PatientLocation</span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Description / Notes</small>
                        <p class="mb-0 text-dark">@Model.PatientDescription</p>
                    </div>
                </div>
            </div>

            <!-- Existing Medical Record Banner -->
            @if (Model.MedicalRecordPath != null)
            {
                <div class="alert alert-info d-flex align-items-center mt-4 mb-0 rounded-3 shadow-sm" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-file-earmark-check me-3 flex-shrink-0" viewBox="0 0 16 16">
                        <path d="M10.854 7.854a.5.5 0 0 0-.708-.708L7.5 9.793 6.354 8.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0l3-3z" />
                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z" />
                    </svg>
                    <div>
                        <strong class="d-block text-dark">Current Medical Record Attached</strong>
                        <small class="text-muted text-break">Path: @Model.MedicalRecordPath</small>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Upload Section -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <!-- Header with Icon -->
                    <div class="text-center mb-4">
                        <div class="d-inline-flex p-3 bg-light text-primary rounded-circle mb-3 shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-file-medical" viewBox="0 0 16 16">
                                <path d="M8.5 4.5a.5.5 0 0 0-1 0v.634l-.549-.317a.5.5 0 1 0-.5.866L7 6l-.549.317a.5.5 0 1 0 .5.866l.549-.317V7.5a.5.5 0 0 0 1 0v-.634l.549.317a.5.5 0 1 0 .5-.866L9 6l.549-.317a.5.5 0 1 0-.5-.866l-.549.317V4.5z" />
                                <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" />
                            </svg>
                        </div>
                        <h2 class="h4 fw-bold text-dark">Upload Medical Record</h2>
                        <p class="text-muted small">Select and attach a new medical file for this patient.</p>
                    </div>

                    <!-- Form -->
                    <form asp-action="UploadMedicalRecord" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="MedicalRecord" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="MedicalRecord" type="file" class="form-control form-control-lg" />
                            <span asp-validation-for="MedicalRecord" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Hidden Inputs -->
                        <input type="hidden" asp-for="PatientId" />
                        <input type="hidden" asp-for="MedicalRecordPath" />

                        <!-- Submit Button -->
                        <div class="d-grid mt-4">
                            <input type="submit" value="Upload Record" class="btn btn-primary btn-lg fw-semibold shadow-sm" />
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>