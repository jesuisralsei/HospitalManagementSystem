@model IEnumerable<MyProject.Models.Department>
@{
    ViewData["Title"] = "Departments";
    var isAdmin = User.IsInRole("Admin");
}

@section Styles {
    <style>
        .dept-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
        .dept-card { display: flex; flex-direction: column; justify-content: space-between; transition: transform .2s, box-shadow .2s; }
        .dept-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(0,0,0,.08); }
        .dept-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
        .dept-name { margin: 0; font-size: 17px; font-weight: 700; }
        .dept-location { font-size: 13px; color: var(--text-muted); }
        .dept-desc { font-size: 13px; color: var(--text-muted); margin: 0 0 16px; min-height: 38px;
                     display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .dept-metrics { display: grid; grid-template-columns: 1fr 1fr; background: var(--bg-body); border-radius: 8px; padding: 12px; text-align: center; margin-bottom: 16px; }
        .dept-metrics div + div { border-left: 1px solid var(--border-color); }
        .metric-label { display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); }
        .metric-value { font-size: 20px; font-weight: 700; }
        .dept-contact { font-size: 13px; color: var(--text-muted); }
        .dept-contact div { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px; }
        .dept-footer { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--border-color); font-size: 12px; color: var(--text-muted); }
    </style>
}

<div class="page-header">
    <div>
        <h1>Hospital Departments</h1>
        <p>Manage active clinical units, capacity, and facility details.</p>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="AddDepartment">+ Add Department</a>
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="dept-grid">
        @foreach (var d in Model)
        {
            <div class="card dept-card">
                <div>
                    <div class="dept-top">
                        <div>
                            <h4 class="dept-name">@d.Name</h4>
                            <span class="dept-location">@(string.IsNullOrEmpty(d.Location) ? "Main Facility" : d.Location)</span>
                        </div>
                        <span class="badge @(d.IsActive ? "badge-success" : "badge-danger")">
                            @(d.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <p class="dept-desc">
                        @(string.IsNullOrEmpty(d.Description) ? "No description provided for this clinical unit." : d.Description)
                    </p>

                    <div class="dept-metrics">
                        <div>
                            <span class="metric-label">Beds</span>
                            <span class="metric-value">@d.NumberOfBeds</span>
                        </div>
                        <div>
                            <span class="metric-label">Capacity</span>
                            <span class="metric-value">@d.Capacity</span>
                        </div>
                    </div>

                    <div class="dept-contact">
                        <div>📞 @(string.IsNullOrEmpty(d.PhoneNumber) ? "No phone listed" : d.PhoneNumber)</div>
                        <div>✉️ @(string.IsNullOrEmpty(d.Email) ? "No email listed" : d.Email)</div>
                    </div>
                </div>

                <div class="dept-footer">Added: @d.CreatedAt.ToString("MMM dd, yyyy")</div>
            </div>
        }
    </div>
}
else
{
    <div class="card empty-state">
        <h3>No Departments Found</h3>
        <p>Get started by adding your first hospital department to the system.</p>
        @if (isAdmin)
        {
            <a class="btn btn-primary" asp-action="AddDepartment">+ Add Department</a>
        }
    </div>
}