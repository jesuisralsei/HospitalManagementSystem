@model IEnumerable<MyProject.Models.Doctor>

@{
    ViewData["Title"] = "Doctors Directory";
}


<div class="container py-5">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark display-6 mb-1">
                <i class="bi bi-person-badge-fill text-success me-2"></i>Medical Staff & Doctors
            </h1>
            <p class="text-muted mb-0">Browse doctor profiles, specialties, and their assigned patient lists.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="AddDoctor" class="btn btn-success text-white fw-semibold shadow-sm px-4 py-2 rounded-pill">
                <i class="bi bi-person-plus-fill me-1"></i> Add Doctor
            </a>
            <a asp-controller="Hospital" asp-action="DashBoard" class="btn btn-light border fw-semibold px-4 py-2 rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Doctors Table / Card Grid View -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-xs" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="py-3 ps-4">Doctor</th>
                            <th class="py-3">Specialty / Professionality</th>
                            <th class="py-3">Bio / Description</th>
                            <th class="py-3 text-center">Age & Location</th>
                            <th class="py-3 pe-4">Assigned Patients</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model)
                        {
                            <tr>
                                <!-- Doctor Name & ID -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 45px; height: 45px; min-width: 45px;">
                                            <i class="bi bi-person-fill fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@doctor.DoctorName</h6>
                                            <span class="text-muted" style="font-size: 0.75rem;">ID: #@doctor.DoctorId</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Professionality / Specialty -->
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill fw-semibold">
                                        @(string.IsNullOrEmpty(doctor.DoctorProfessionality) ? "General Practice" : doctor.DoctorProfessionality)
                                    </span>
                                </td>

                                <!-- Description -->
                                <td>
                                    <span class="text-muted small text-truncate d-block" style="max-width: 220px;" title="@doctor.DoctorDescription">
                                        @(string.IsNullOrEmpty(doctor.DoctorDescription) ? "No description provided." : doctor.DoctorDescription)
                                    </span>
                                </td>

                                <!-- Age & Location -->
                                <td class="text-center">
                                    <div class="small text-dark fw-medium">@doctor.DoctorAge yrs</div>
                                    <div class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(doctor.DoctorLocation) ? "Main Clinic" : doctor.DoctorLocation)</div>
                                </td>

                                <!-- Patients Badges -->
                                <td class="pe-4 py-3">
                                    @if (doctor.Patients != null && doctor.Patients.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1" style="max-width: 250px;">
                                            @foreach (var patient in doctor.Patients)
                                            {
                                                <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill small fw-normal">
                                                    <i class="bi bi-person text-primary me-1"></i>@patient.PatientName
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">No patients assigned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5 bg-white rounded-4 border border-2 border-dashed shadow-sm">
            <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                <i class="bi bi-person-slash"></i>
            </div>
            <h3 class="fw-bold text-dark">No Doctors Found</h3>
            <p class="text-muted small mb-4">Get started by onboarding your first doctor into the directory.</p>
            <a asp-action="AddDoctor" class="btn btn-success text-white fw-semibold px-4 py-2 rounded-pill shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add Doctor
            </a>
        </div>
    }
</div>

<!-- Custom Polish Styles -->
<style>
    .table-hover tbody tr:hover {
        background-color: rgba(25, 135, 84, 0.02);
    }
</style>