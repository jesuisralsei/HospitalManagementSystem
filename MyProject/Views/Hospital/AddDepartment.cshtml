@model MyProject.Models.Department


<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    <!-- Form Header -->
                    <div class="text-center mb-4">
                        <div class="mb-2 text-primary fs-1">
                            <i class="bi bi-hospital"></i>
                        </div>
                        <h2 class="fw-bold">Add New Department</h2>
                        <p class="text-muted small">Enter the details below to register a new hospital department.</p>
                    </div>

                    <!-- Form -->
                    <form asp-action="AddDepartment" method="post" class="needs-validation" novalidate>

                        <!-- Department Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Department Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., Cardiology, Emergency" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief overview of the department..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label asp-for="Location" class="form-label fw-semibold">Location / Wing</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g., West Wing, Floor 3" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <!-- Contact Info Row -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                                <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="e.g., +1 (555) 019-2834" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="e.g., cardiology@hospital.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Metrics / Capacities Row -->
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Capacity" class="form-label fw-semibold">Capacity</label>
                                <input asp-for="Capacity" type="number" class="form-control" placeholder="e.g., 50" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="NumberOfBeds" class="form-label fw-semibold">Number of Beds</label>
                                <input asp-for="NumberOfBeds" type="number" class="form-control" placeholder="e.g., 20" />
                                <span asp-validation-for="NumberOfBeds" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <select asp-for="HeadDoctorId" class="form-control">
                                    <option value="">-- Select Head Doctor --</option>

                                    @foreach (var doctor in ViewBag.Doctors)
                                    {
                                        <option value="@doctor.DoctorId">
                                            @doctor.DoctorName
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Status Switch -->
                        <div class="mb-4 form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked />
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">Active Department</label>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg text-white shadow-sm">Save Department</button>
                            <a asp-action="Index" class="btn btn-light text-muted border">Cancel</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>