@{
    ViewData["Title"] = "Hospital Management Dashboard";
}
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Alpine.js for interactivity -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="h-full font-sans antialiased text-gray-900" x-data="{ sidebarOpen: false }">

    <div class="min-h-screen flex flex-col">
        <!-- Top Navigation Bar -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-30 shadow-xs">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-md">
                        <i class="fa-solid fa-hospital-user text-xl"></i>
                    </div>
                    <span class="text-xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">HM SoftWare</span>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-sm font-medium text-gray-500 hidden sm:inline">Hospital Admin Portal</span>
                    <div class="h-8 w-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
            
            <!-- Welcome Header -->
            <div class="mb-8">
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Dashboard Overview</h1>
                <p class="mt-1 text-sm text-gray-500">Manage your patients, doctors, and departments seamlessly from one hub.</p>
            </div>

            <!-- Quick Stats Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
                <div class="bg-white overflow-hidden shadow-xs rounded-2xl border border-gray-100 p-5">
                    <div class="flex items-center">
                        <div class="p-3 rounded-xl bg-blue-50 text-blue-600 text-xl"><i class="fa-solid fa-hospital"></i></div>
                        <div class="ml-4">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">System Status</p>
                            <h3 class="text-lg font-bold text-gray-900 mt-1">Operational</h3>
                        </div>
                    </div>
                </div>
                <div class="bg-white overflow-hidden shadow-xs rounded-2xl border border-gray-100 p-5">
                    <div class="flex items-center">
                        <div class="p-3 rounded-xl bg-emerald-50 text-emerald-600 text-xl"><i class="fa-solid fa-user-doctor"></i></div>
                        <div class="ml-4">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Quick Action</p>
                            <a asp-controller="Hospital" asp-action="Doctor" class="text-sm font-semibold text-emerald-600 hover:underline mt-1 block">View Doctors &rarr;</a>
                        </div>
                    </div>
                </div>
                <div class="bg-white overflow-hidden shadow-xs rounded-2xl border border-gray-100 p-5">
                    <div class="flex items-center">
                        <div class="p-3 rounded-xl bg-purple-50 text-purple-600 text-xl"><i class="fa-solid fa-bed-pulse"></i></div>
                        <div class="ml-4">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Quick Action</p>
                            <a asp-controller="Hospital" asp-action="Patient" class="text-sm font-semibold text-purple-600 hover:underline mt-1 block">View Patients &rarr;</a>
                        </div>
                    </div>
                </div>
                <div class="bg-white overflow-hidden shadow-xs rounded-2xl border border-gray-100 p-5">
                    <div class="flex items-center">
                        <div class="p-3 rounded-xl bg-amber-50 text-amber-600 text-xl"><i class="fa-solid fa-sitemap"></i></div>
                        <div class="ml-4">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Quick Action</p>
                            <a asp-controller="Hospital" asp-action="Departments" class="text-sm font-semibold text-amber-600 hover:underline mt-1 block">View Departments &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
                <div class="bg-white overflow-hidden shadow-xs rounded-2xl border border-gray-100 p-5">
                    <div class="flex items-center">
                        <div class="p-3 rounded-xl bg-blue-50 text-blue-600 text-xl"><i class="fa-solid fa-hospital"></i></div>
                        <div class="ml-4">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">System Status</p>
                            <h3 class="text-lg font-bold text-gray-900 mt-1">Operational</h3>
                        </div>
                    </div>
                </div>

                <!-- Total Doctors -->
                <div class="bg-white overflow-hidden shadow-xs rounded-2xl border border-gray-100 p-5">
                    <div class="flex items-center">
                        <div class="p-3 rounded-xl bg-emerald-50 text-emerald-600 text-xl"><i class="fa-solid fa-user-doctor"></i></div>
                        <div class="ml-4">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Doctors</p>
                            <h3 class="text-xl font-extrabold text-gray-900 mt-1">@ViewBag.DoctorCount</h3>
                        </div>
                    </div>
                </div>

                <!-- Total Patients -->
                <div class="bg-white overflow-hidden shadow-xs rounded-2xl border border-gray-100 p-5">
                    <div class="flex items-center">
                        <div class="p-3 rounded-xl bg-purple-50 text-purple-600 text-xl"><i class="fa-solid fa-bed-pulse"></i></div>
                        <div class="ml-4">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Patients</p>
                            <h3 class="text-xl font-extrabold text-gray-900 mt-1">@ViewBag.PatientCount</h3>
                        </div>
                    </div>
                </div>

                <!-- Total Departments -->
                <div class="bg-white overflow-hidden shadow-xs rounded-2xl border border-gray-100 p-5">
                    <div class="flex items-center">
                        <div class="p-3 rounded-xl bg-amber-50 text-amber-600 text-xl"><i class="fa-solid fa-sitemap"></i></div>
                        <div class="ml-4">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Departments</p>
                            <h3 class="text-xl font-extrabold text-gray-900 mt-1">@ViewBag.DepartmentCount</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Cards Grid Linked to HospitalController -->
            <h2 class="text-lg font-bold text-gray-900 mb-4">Management Modules</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                <!--Action Live Counts-->



                <!-- 1. View Patients Card -->
                <div class="bg-white rounded-2xl shadow-xs border border-gray-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                    <div class="p-6">
                        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
                            <i class="fa-solid fa-hospital-user"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Patients Directory</h3>
                        <p class="text-sm text-gray-500 mt-1">View and manage the comprehensive list of registered hospital patients.</p>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a asp-controller="Hospital" asp-action="Patient" class="w-full inline-flex justify-center items-center px-4 py-2.5 border border-blue-600 text-blue-600 font-semibold rounded-xl text-sm hover:bg-blue-600 hover:text-white transition-colors duration-200">
                            View Patients
                        </a>
                    </div>
                </div>

                <!-- 2. View Doctors Card -->
                <div class="bg-white rounded-2xl shadow-xs border border-gray-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                    <div class="p-6">
                        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-4 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
                            <i class="fa-solid fa-user-doctor"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Medical Staff</h3>
                        <p class="text-sm text-gray-500 mt-1">Browse active doctors, specialties, and their associated patient rosters.</p>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a asp-controller="Hospital" asp-action="Doctor" class="w-full inline-flex justify-center items-center px-4 py-2.5 border border-emerald-600 text-emerald-600 font-semibold rounded-xl text-sm hover:bg-emerald-600 hover:text-white transition-colors duration-200">
                            View Doctors
                        </a>
                    </div>
                </div>

                <!-- 3. View Departments Card -->
                <div class="bg-white rounded-2xl shadow-xs border border-gray-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                    <div class="p-6">
                        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl mb-4 group-hover:bg-amber-600 group-hover:text-white transition-colors duration-300">
                            <i class="fa-solid fa-building-ngo"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Departments</h3>
                        <p class="text-sm text-gray-500 mt-1">Explore all hospital departments and organizational units.</p>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a asp-controller="Hospital" asp-action="Departments" class="w-full inline-flex justify-center items-center px-4 py-2.5 border border-amber-600 text-amber-600 font-semibold rounded-xl text-sm hover:bg-amber-600 hover:text-white transition-colors duration-200">
                            View Departments
                        </a>
                    </div>
                </div>

                <!-- 4. Add Patient Card -->
                <div class="bg-white rounded-2xl shadow-xs border border-gray-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                    <div class="p-6">
                        <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl mb-4 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-300">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Register Patient</h3>
                        <p class="text-sm text-gray-500 mt-1">Onboard and register a new patient into the database system.</p>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a asp-controller="Hospital" asp-action="AddPatient" class="w-full inline-flex justify-center items-center px-4 py-2.5 bg-indigo-600 text-white font-semibold rounded-xl text-sm hover:bg-indigo-700 transition-colors duration-200 shadow-sm">
                            Add Patient
                        </a>
                    </div>
                </div>

                <!-- 5. Add Doctor Card -->
                <div class="bg-white rounded-2xl shadow-xs border border-gray-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                    <div class="p-6">
                        <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl mb-4 group-hover:bg-teal-600 group-hover:text-white transition-colors duration-300">
                            <i class="fa-solid fa-user-nurse"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Add Doctor</h3>
                        <p class="text-sm text-gray-500 mt-1">Register a new medical professional onto the hospital directory.</p>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a asp-controller="Hospital" asp-action="AddDoctor" class="w-full inline-flex justify-center items-center px-4 py-2.5 bg-teal-600 text-white font-semibold rounded-xl text-sm hover:bg-teal-700 transition-colors duration-200 shadow-sm">
                            Add Doctor
                        </a>
                    </div>
                </div>

                <!-- 6. Add Department Card -->
                <div class="bg-white rounded-2xl shadow-xs border border-gray-200/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                    <div class="p-6">
                        <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl mb-4 group-hover:bg-rose-600 group-hover:text-white transition-colors duration-300">
                            <i class="fa-solid fa-plus-circle"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900">Add Department</h3>
                        <p class="text-sm text-gray-500 mt-1">Create a brand new department unit within the facility.</p>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a asp-controller="Hospital" asp-action="AddDepartment" class="w-full inline-flex justify-center items-center px-4 py-2.5 bg-rose-600 text-white font-semibold rounded-xl text-sm hover:bg-rose-700 transition-colors duration-200 shadow-sm">
                            Add Department
                        </a>
                    </div>
                </div>

            </div>
            <!--Add  -->
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-gray-200 mt-12 py-6 text-center text-xs text-gray-400">
            &copy; 2026 MediCare Hospital Management System. All rights reserved.
        </footer>
    </div>

</body>
</html>