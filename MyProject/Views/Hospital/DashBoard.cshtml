@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Admin");

    var modules = new List<(string Title, string Text, string Action, string Button, bool AdminOnly)>
    {
        ("Patients Directory", "View and manage registered hospital patients.", "Patient", "View Patients", false),
        ("Medical Staff", "Browse doctors and their assigned patients.", "Doctor", "View Doctors", false),
        ("Departments", "Explore hospital departments and organizational units.", "Departments", "View Departments", false),
        ("Register Patient", "Register a new patient in the system.", "AddPatient", "Add Patient", true),
        ("Add Doctor", "Register a new medical professional.", "AddDoctor", "Add Doctor", true),
        ("Add Department", "Create a new hospital department.", "AddDepartment", "Add Department", true)
    };
}

@section Styles {
    <style>
        .module-card { display: flex; flex-direction: column; justify-content: space-between; min-height: 175px; }
        .module-card h3 { margin: 0 0 8px; font-size: 17px; }
        .module-card p { margin: 0 0 20px; font-size: 13px; color: var(--text-muted); }
        .section-title { margin: 32px 0 16px; font-size: 19px; font-weight: 700; }
    </style>
}

<div class="page-header">
    <div>
        <h1>Dashboard Overview</h1>
        <p>Manage your hospital operations from one place.</p>
    </div>
</div>

<div class="grid grid-stats">
    <div class="card stat-card">
        <div class="stat-label">Total Doctors</div>
        <div class="stat-value">@ViewBag.DoctorCount</div>
    </div>
    <div class="card stat-card">
        <div class="stat-label">Total Patients</div>
        <div class="stat-value">@ViewBag.PatientCount</div>
    </div>
    <div class="card stat-card">
        <div class="stat-label">Total Departments</div>
        <div class="stat-value">@ViewBag.DepartmentCount</div>
    </div>
</div>

<h2 class="section-title">Management Modules</h2>

<div class="grid grid-auto">
    @foreach (var m in modules.Where(m => !m.AdminOnly || isAdmin))
    {
        <div class="card card-hover module-card">
            <div>
                <h3>@m.Title</h3>
                <p>@m.Text</p>
            </div>
            <a class="btn btn-secondary" asp-controller="Hospital" asp-action="@m.Action">@m.Button</a>
        </div>
    }
</div>
