@model MyProject.Models.DoctorViewModel

@{
    ViewData["Title"] = "Doctors";
    var isAdmin = User.IsInRole("Admin");
    var doctors = Model?.Doctors;
    var current = Model?.CurrentPage ?? 1;
    var total = Model?.TotalPages ?? 0;
}

@section Styles {
    <style>
        .search-bar { display: flex; gap: 10px; margin-bottom: 20px; }
        .search-bar input { flex: 1; }
        .person { display: flex; align-items: center; gap: 12px; }
        .person strong { display: block; line-height: 1.2; }
        .person small { color: var(--text-muted); font-size: 12px; }
        .chips { display: flex; flex-wrap: wrap; gap: 4px; max-width: 260px; }
        .chip { font-size: 12px; padding: 2px 9px; border-radius: 999px; background: var(--bg-subtle); border: 1px solid var(--border-color); }
        .desc { max-width: 220px; font-size: 13px; color: var(--text-muted); }
        .actions { white-space: nowrap; text-align: right; }
        @@media (max-width: 640px) { .search-bar { flex-direction: column; } }
    </style>
}

<div class="page-header">
    <div>
        <h1>Medical Staff &amp; Doctors</h1>
        <p>Browse doctor profiles, specialties, and their assigned patient lists.</p>
    </div>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="AddDoctor">+ Add Doctor</a>
    }
</div>

<form asp-action="Doctor" method="get" class="search-bar">
    <input name="term" value="@Model?.Term" class="form-control" placeholder="Search doctors by name..." />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

@if (doctors != null && doctors.Any())
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Specialty</th>
                    <th>Bio</th>
                    <th>Age &amp; Location</th>
                    <th>Assigned Patients</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in doctors)
                {
                    var initial = string.IsNullOrEmpty(d.DoctorName) ? "?" : d.DoctorName.Substring(0, 1).ToUpper();
                    <tr>
                        <td>
                            <div class="person">
                                <span class="avatar">@initial</span>
                                <div>
                                    <strong>@d.DoctorName</strong>
                                    <small>ID: #@d.DoctorId</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-primary">
                                @(string.IsNullOrEmpty(d.DoctorProfessionality) ? "General Practice" : d.DoctorProfessionality)
                            </span>
                        </td>
                        <td>
                            <div class="desc truncate" title="@d.DoctorDescription">
                                @(string.IsNullOrEmpty(d.DoctorDescription) ? "No description provided." : d.DoctorDescription)
                            </div>
                        </td>
                        <td>
                            <div>@d.DoctorAge yrs</div>
                            <div class="muted small">@(string.IsNullOrEmpty(d.DoctorLocation) ? "Main Clinic" : d.DoctorLocation)</div>
                        </td>
                        <td>
                            @if (d.Patients != null && d.Patients.Any())
                            {
                                <div class="chips">
                                    @foreach (var p in d.Patients.Take(3))
                                    {
                                        <span class="chip">@p.PatientName</span>
                                    }
                                    @if (d.Patients.Count() > 3)
                                    {
                                        <span class="chip">+@(d.Patients.Count() - 3) more</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="muted small">No patients assigned</span>
                            }
                        </td>
                        <td class="actions">
                            <a class="btn btn-secondary btn-sm" asp-action="DoctorDetails" asp-route-id="@d.DoctorId">Details</a>
                            @if (isAdmin)
                            {
                                <a class="btn btn-primary btn-sm" asp-action="UpdateDoctor" asp-route-id="@d.DoctorId">Edit</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (total > 1)
    {
        var start = Math.Max(1, current - 2);
        var end = Math.Min(total, current + 2);

        <div class="pagination">
            @if (current > 1)
            {
                <a asp-action="Doctor" asp-route-term="@Model.Term" asp-route-OrderBy="@Model.OrderBy" asp-route-CurrentPage="@(current - 1)">&laquo;</a>
            }
            @for (var i = start; i <= end; i++)
            {
                if (i == current)
                {
                    <span class="current">@i</span>
                }
                else
                {
                    <a asp-action="Doctor" asp-route-term="@Model.Term" asp-route-OrderBy="@Model.OrderBy" asp-route-CurrentPage="@i">@i</a>
                }
            }
            @if (current < total)
            {
                <a asp-action="Doctor" asp-route-term="@Model.Term" asp-route-OrderBy="@Model.OrderBy" asp-route-CurrentPage="@(current + 1)">&raquo;</a>
            }
        </div>
    }
}
else
{
    <div class="card empty-state">
        <h3>No Doctors Found</h3>
        <p>No records match your search, or the directory is empty.</p>
        @if (isAdmin)
        {
            <a class="btn btn-primary" asp-action="AddDoctor">+ Add Doctor</a>
        }
    </div>
}
