@model MyProject.Models.PatientViewModel

@{
    ViewData["Title"] = "Patients Directory";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark display-6 mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Registered Patients
            </h1>
            <p class="text-muted mb-0">View and manage the comprehensive list of registered hospital patients.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="AddPatient" class="btn btn-primary text-white fw-semibold shadow-sm px-4 py-2 rounded-pill">
                <i class="bi bi-person-plus-fill me-1"></i> Add Patient
            </a>
            <a asp-controller="Hospital" asp-action="DashBoard" class="btn btn-light border fw-semibold px-4 py-2 rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form asp-action="Patient" method="get" class="row g-2 align-items-center">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 pe-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input name="term" value="@Model?.Term" class="form-control border-start-0 ps-2" placeholder="Search patients by name, ID, or location..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold rounded-3">
                        Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Patients Table View -->
    @if (Model?.Patients != null && Model.Patients.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-xs" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="py-3 ps-4">
@*                                 href="/Hospital/Patient?orderby=@Model.OrderBy&term=@Model.Term"
 *@                                <a asp-action="Patient" asp-route-orderby="@(Model.OrderBy == "name_desc" ? "name_asc" : "name_desc")" class="text-decoration-none text-dark d-flex align-items-center gap-1">
                                    Patient <i class="bi bi-arrow-down-up text-muted"></i>
                                    
                                </a>
                            </th>
                            <th class="py-3">Medical Description / Notes</th>
                            <th class="py-3 text-center">Age</th>
                            <th class="py-3">Location / Ward</th>
                            <th class="py-3 pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <!-- Patient Name & ID -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px; min-width: 42px;">
                                            <i class="bi bi-person-heart fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@patient.PatientName</h6>
                                            <span class="text-muted" style="font-size: 0.75rem;">ID: #@patient.PatientId</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Description -->
                                <td>
                                    <span class="text-muted small d-block text-truncate" style="max-width: 280px;" title="@patient.PatientDescription">
                                        @(string.IsNullOrEmpty(patient.PatientDescription) ? "No medical notes provided." : patient.PatientDescription)
                                    </span>
                                </td>

                                <!-- Age -->
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-3 py-1.5 rounded-pill fw-semibold">
                                        @patient.PatientAge yrs
                                    </span>
                                </td>

                                <!-- Location / Ward -->
                                <td class="py-3">
                                    <span class="text-dark fw-medium small">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>
                                        @(string.IsNullOrEmpty(patient.PatientLocation) ? "Main Ward" : patient.PatientLocation)
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="pe-4 py-3 text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="@Url.Action("PatientDetails", "Hospital", new { id = patient.PatientId })" class="btn btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a href="@Url.Action("UpdatePatient", "Hospital", new { id = patient.PatientId })" class="btn btn-outline-secondary" title="Edit Patient Data">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="d-flex justify-content-center mt-4">
                <ul class="pagination shadow-sm">
                    @for (int i = 1; i < Model.TotalPages; i++)
                    {
                        var pageNumber = i; // Adjust starting index if your app uses 1-based indexing (change to i = 1 and i <= Model.TotalPages if needed)
                        var displayLabel = i;
                        var activeClass = (pageNumber == Model.CurrentPage) ? "active" : "";

                        <li class="page-item @activeClass">
                            <a class="page-link" href="/Hospital/Patient?term=@Model.Term&OrderBy=@Model.OrderBy&CurrentPage=@pageNumber">
                                @displayLabel
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5 bg-white rounded-4 border border-2 border-dashed shadow-sm">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                <i class="bi bi-person-slash"></i>
            </div>
            <h3 class="fw-bold text-dark">No Patients Found</h3>
            <p class="text-muted small mb-4">No records match your search query or directory is empty.</p>
            <a asp-action="AddPatient" class="btn btn-primary text-white fw-semibold px-4 py-2 rounded-pill shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add Patient
            </a>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.02);
    }

    .input-group-text, .form-control {
        border-color: #dee2e6;
    }

        .form-control:focus {
            box-shadow: none;
            border-color: #0d6efd;
        }
</style>