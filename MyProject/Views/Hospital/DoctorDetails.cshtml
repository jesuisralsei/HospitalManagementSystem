@model MyProject.Models.Doctor

@{
    ViewData["Title"] = $"Dr. {Model.DoctorName} Details";
}

<div class="container py-4">
    <!-- Doctor Profile Header -->
    <div class="card shadow border-0 rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex align-items-center mb-4">
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle me-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-person-badge" viewBox="0 0 16 16">
                        <path d="M6.5 2a0.5 0.5 0 0 0-0.5 0.5v1a0.5 0.5 0 0 0 1 0v-1A0.5 0.5 0 0 0 6.5 2zM11 2.5a0.5 0.5 0 0 1 .5-.5h1a0.5 0.5 0 0 1 0 1h-1a0.5 0.5 0 0 1-.5-.5z" />
                        <path d="M4 3h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm8 1H4a1 1 0 0 0-1 1v7.05h10V5a1 1 0 0 0-1-1zm1 9.05H3V13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-.95z" />
                    </svg>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-dark">Dr. @Model.DoctorName</h1>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="badge bg-success-subtle text-success fw-medium px-3 py-2 rounded-pill">
                            Doctor ID: @Model.DoctorId
                        </span>
                        <span class="badge bg-light text-dark border fw-medium px-3 py-2 rounded-pill">
                            Specialty: @(string.IsNullOrEmpty(Model.DoctorProfessionality) ? "General Practice" : Model.DoctorProfessionality)
                        </span>
                    </div>
                </div>
            </div>

            <hr class="text-muted my-4" />

            <!-- Details Grid -->
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Age</small>
                        <span class="fs-5 fw-semibold text-dark">@Model.DoctorAge Years</span>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Location</small>
                        <span class="fs-5 fw-semibold text-dark">
                            <i class="bi bi-geo-alt me-1 text-success"></i>@(string.IsNullOrEmpty(Model.DoctorLocation) ? "Main Clinic" : Model.DoctorLocation)
                        </span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1">Description / Professional Bio</small>
                        <p class="mb-0 text-dark">@(string.IsNullOrEmpty(Model.DoctorDescription) ? "No description provided." : Model.DoctorDescription)</p>
                    </div>
                </div>
            </div>

            <!-- Assigned Patients Section -->
            <div class="mt-4 p-4 bg-light rounded-3">
                <h5 class="fw-bold text-dark mb-3">Assigned Patients</h5>
                @if (Model.Patients != null && Model.Patients.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var patient in Model.Patients)
                        {
                            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm fw-normal fs-6">
                                <i class="bi bi-person text-success me-1"></i>@patient.PatientName
                                <span class="text-muted small ms-1">(ID: @patient.PatientId)</span>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic mb-0">No patients currently assigned to this doctor.</p>
                }
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-action="DashBoard" class="btn btn-outline-secondary px-4 rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Back to Directory
                </a>
                <a asp-action="UpdateDoctor" asp-route-id="@Model.DoctorId" class="btn btn-success px-4 rounded-pill shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit Doctor
                </a>
            </div>

        </div>
    </div>
</div>