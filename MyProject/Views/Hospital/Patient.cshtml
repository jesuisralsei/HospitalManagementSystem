@model IEnumerable<MyProject.Models.Patient>

@{
    ViewData["Title"] = "Patients Directory";
}


<div class="container py-5">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark display-6 mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Registered Patients
            </h1>
            <p class="text-muted mb-0">View and manage the comprehensive list of registered hospital patients.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="AddPatient" class="btn btn-primary text-white fw-semibold shadow-sm px-4 py-2 rounded-pill">
                <i class="bi bi-person-plus-fill me-1"></i> Add Patient
            </a>
            <a asp-controller="Hospital" asp-action="DashBoard" class="btn btn-light border fw-semibold px-4 py-2 rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Patients Table View -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-xs" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <tr>
                            <th class="py-3 ps-4">Patient</th>
                            <th class="py-3">Medical Description / Notes</th>
                            <th class="py-3 text-center">Age</th>
                            <th class="py-3 pe-4">Location / Ward</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <!-- Patient Name & ID -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 45px; height: 45px; min-width: 45px;">
                                            <i class="bi bi-person-heart fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@patient.PatientName</h6>
                                            <span class="text-muted" style="font-size: 0.75rem;">ID: #@patient.PatientId</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Description -->
                                <td>
                                    <span class="text-muted small d-block" style="max-width: 320px;" title="@patient.PatientDescription">
                                        @(string.IsNullOrEmpty(patient.PatientDescription) ? "No medical notes provided." : patient.PatientDescription)
                                    </span>
                                </td>

                                <!-- Age -->
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-3 py-1.5 rounded-pill fw-semibold">
                                        @patient.PatientAge yrs
                                    </span>
                                </td>

                                <!-- Location / Ward -->
                                <td class="pe-4 py-3">
                                    <span class="text-dark fw-medium small">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>@(string.IsNullOrEmpty(patient.PatientLocation) ? "Main Ward" : patient.PatientLocation)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5 bg-white rounded-4 border border-2 border-dashed shadow-sm">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                <i class="bi bi-person-slash"></i>
            </div>
            <h3 class="fw-bold text-dark">No Patients Found</h3>
            <p class="text-muted small mb-4">Get started by registering your first patient into the system.</p>
            <a asp-action="AddPatient" class="btn btn-primary text-white fw-semibold px-4 py-2 rounded-pill shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add Patient
            </a>
        </div>
    }
</div>

<!-- Custom Polish Styles -->
<style>
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.02);
    }
</style>